{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!!.pi/skills",
      "!!.semgrep",
      "!!.biome",
      "!**/*.{yml,yaml}"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "domains": { "next": "recommended", "react": "recommended" },
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noProcessEnv": "error" },
      "suspicious": { "noImportCycles": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.{ts,tsx,mts,cts}"],
      "linter": {
        "rules": {
          "complexity": { "noBannedTypes": "error" },
          "nursery": {
            "noMisleadingReturnType": "error",
            "noUselessTypeAssertion": "error",
            "useExhaustiveSwitchCases": {
              "level": "error",
              "options": { "requireExplicitCase": true }
            },
            "useStrictBooleanExpressions": "error"
          },
          "style": {
            "noEnum": "error",
            "noInferrableTypes": "error",
            "noNamespace": "error",
            "noParameterProperties": "error",
            "useAsConstAssertion": "error",
            "useReadonlyClassProperties": "error",
            "useReduceTypeParameter": "error"
          },
          "suspicious": {
            "noExplicitAny": "error",
            "noExtraNonNullAssertion": "error",
            "noNonNullAssertedOptionalChain": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.{ts,tsx,mts,cts}",
        "!**/*.{test,spec}.{ts,tsx,mts,cts}"
      ],
      "linter": { "rules": { "nursery": { "noUnsafeReturn": "error" } } }
    },
    {
      "includes": [
        "apps/web/components/ThemeSwitcher/ThemeSwitcher.module.css"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": {
              "level": "error",
              "options": { "ignore": ["mixin"] }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/app/**/page.tsx",
        "apps/web/app/**/layout.tsx",
        "apps/web/components/FathomAnalytics/FathomAnalytics.tsx",
        "apps/*/cli.ts",
        "**/*.test.{ts,tsx}",
        "**/test.ts",
        "**/*.config.{ts,js,mjs,cjs,mts,cts}"
      ],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": ["apps/web/components/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["..", "../**", "@/**"],
                    "message": "Components must remain standalone. Inject app code and sibling components through props in app/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "plugins": [
    {
      "includes": [
        "**/*.{ts,tsx,mts,cts}",
        "!**/*.{test,spec}.{ts,tsx,mts,cts}"
      ],
      "path": "./.biome/no-literal-type-assertions.grit"
    }
  ],
  "vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true }
}
