{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!apps/web/components/**/*.module.css",
      "!!.pi/skills",
      "!!.semgrep"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "domains": { "next": "recommended", "react": "recommended" },
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noProcessEnv": "error" },
      "suspicious": { "noImportCycles": "error" }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/app/**/page.tsx",
        "apps/web/app/**/layout.tsx",
        "apps/*/cli.ts",
        "**/*.test.{ts,tsx}",
        "**/test.ts",
        "**/*.config.{ts,js,mjs,cjs,mts,cts}"
      ],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": ["apps/web/components/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["..", "../**", "@/**"],
                    "message": "Components must remain standalone. Inject app code and sibling components through props in app/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true }
}
