{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!components/**/*.module.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noProcessEnv": "error" },
      "suspicious": { "noImportCycles": "error" }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "app/**/route.ts",
        "app/**/page.tsx",
        "app/**/layout.tsx",
        "scripts/**/*.ts",
        "lib/**/run.ts",
        "lib/env/env.ts",
        "**/*.test.{ts,tsx}",
        "**/test.ts",
        "**/*.config.{ts,js,mjs,cjs}"
      ],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": [
        "lib/**/*.{ts,tsx}",
        "!lib/**/run.ts",
        "!lib/**/*.test.{ts,tsx}",
        "!lib/**/test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/scripts/**",
                      "**/scripts/**",
                      "**/route",
                      "**/route.ts",
                      "**/run",
                      "**/run.ts"
                    ],
                    "message": "Library modules must not import application entrypoints. Inject dependencies from the composition root."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["components/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["..", "../**", "@/**"],
                    "message": "Components must remain standalone. Inject app code and sibling components through props in app/."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
