{
  "name": "quantile.co",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "storybook:build": "storybook build --quiet --disable-telemetry --output-dir storybook-static",
    "storybook:test": "vitest --project=storybook --run",
    "assets:generate": "node scripts/assets.mjs generate",
    "assets:check": "node scripts/assets.mjs check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm assets:check && pnpm build && pnpm storybook:build && pnpm storybook:test",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource/prompt": "5.3.0",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@tabler/icons-react": "3.46.0",
    "motion": "13.4.2",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-themes": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.11",
    "fontkit": "2.0.4",
    "husky": "9.1.7",
    "knip": "6.36.0",
    "playwright": "1.63.0",
    "png-to-ico": "3.0.2",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "sharp": "0.35.4",
    "storybook": "10.6.0",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  }
}
