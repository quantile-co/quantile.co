{
  "name": "@quantile-co/quantile.co",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "tsx apps/repo/cli.ts dev",
    "dev:storybook": "pnpm --filter @quantile-co/web run dev:storybook",
    "check": "turbo run check --cache=local:rw",
    "fix": "turbo run fix --cache=local:rw",
    "test": "pnpm run check && turbo run test --cache=local:rw",
    "test:integration": "pnpm --filter @quantile-co/web run test:integration",
    "build": "turbo run build --cache=local:rw",
    "build:assets": "tsx apps/repo/cli.ts assets",
    "build:storybook": "turbo run build:storybook --cache=local:rw",
    "github:build": "tsx apps/github/cli.ts build",
    "github:plan": "tsx apps/github/cli.ts plan",
    "github:apply": "tsx apps/github/cli.ts apply",
    "skills:sync": "skills experimental_sync --agent pi --copy --yes --include @quantile-co/factory-pi#deploy @quantile-co/factory-pi#day-zero-deploy @quantile-co/factory-pi#seo-audit @quantile-co/factory-pi#web-design-guidelines @quantile-co/factory-pi#web-perf @quantile-co/factory-pi#web-quality-audit @quantile-co/factory-pi#webapp-testing @quantile-co/factory-pi#performance @quantile-co/factory-pi#core-web-vitals @quantile-co/factory-pi#accessibility @quantile-co/factory-pi#seo @quantile-co/factory-pi#best-practices"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@quantile-co/factory-pi": "0.1.0",
    "@types/node": "26.6.5",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "skills": "1.7.4",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.11"
  }
}
