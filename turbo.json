{
  "$schema": "https://turbo.build/schema.json",
  "cacheDir": ".turbo/cache",
  "remoteCache": {
    "enabled": false
  },
  "globalDependencies": ["flake.lock", "tsconfig.json", "biome.json"],
  "globalPassThroughEnv": [
    "NIX_CONFIG",
    "NIX_PATH",
    "NIX_SSL_CERT_FILE",
    "SSL_CERT_FILE",
    "NEXT_TELEMETRY_DISABLED",
    "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH",
    "CI",
    "pnpm_config_offline",
    "npm_config_offline"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "QUANTILE_SITE_ORIGIN",
        "STRIPE_EVENT_LIVEMODE",
        "QUANTILE_DEVELOPMENT_PORTAL_URL",
        "NEXT_PUBLIC_FATHOM_SITE_ID",
        "NEXT_PUBLIC_FATHOM_ALLOWED_DOMAINS"
      ]
    },
    "check": {
      "cache": false
    },
    "fix": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "build:storybook": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["storybook-static/**"],
      "env": [
        "QUANTILE_DEVELOPMENT_PORTAL_URL",
        "STRIPE_EVENT_LIVEMODE",
        "NEXT_PUBLIC_FATHOM_SITE_ID",
        "NEXT_PUBLIC_FATHOM_ALLOWED_DOMAINS"
      ]
    }
  }
}
